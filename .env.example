# Supabase CLI / local Auth configuration
# Copy this file to .env when you want to run the local Supabase stack with OAuth.

SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=

# Optional: enable Google locally by updating supabase/config.toml and setting:
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Frontend Vite env vars (also set these in .env.local for the web app)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional provider keys for local smoke tests only.
# The app stores per-user keys in Supabase via Settings.
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_OPENROUTER_API_KEY=
