# Frontend configuration for Vite
# Copy this file to .env.local.

# Supabase project used by the web app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional provider keys for local smoke tests only.
# The app stores per-user keys in Supabase via Settings.
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
