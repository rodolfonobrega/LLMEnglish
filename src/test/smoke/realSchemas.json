    ],
    "additionalProperties": false
  },
  "listeningPassageResponseSchema": {
    "type": "object",
    "properties": {
      "passage": {
        "type": "string"
      },
      "questions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "expected_key_points": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "accent_hint": {
        "type": "string",
        "enum": [
          "us",
