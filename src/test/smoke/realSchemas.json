      "salient_patterns_observed": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "canonical_pattern": {
              "type": "string"
            },
            "turns_correct": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "turns_incorrect": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "evidence": {
              "type": "string"
            }
          },
          "required": [
            "canonical_pattern",
            "turns_correct",
            "turns_incorrect",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "automaticity_estimate": {
        "type": "string",
        "enum": [
          "low",
          "moderate",
          "high"
        ]
      },
      "confidence_estimate": {
        "type": "string",
        "enum": [
          "cold",
          "recovering",
          "warm",
          "hot"
        ]
      },
      "suggested_next_step": {
        "type": "string"
      },
      "respects_stealth": {
        "type": "boolean"
      },
      "session_size": {
        "type": "string",
        "enum": [
          "standard",
          "mini"
        ]
      },
      "theme": {
        "type": "string"
      }
    },
    "required": [
      "salient_patterns_observed",
      "automaticity_estimate",
      "confidence_estimate",
      "suggested_next_step",
      "respects_stealth",
      "session_size",
      "theme"
    ],
    "additionalProperties": false
  },
