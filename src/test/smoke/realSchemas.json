        "items": {
          "type": "object",
          "properties": {
            "provocation": {
              "type": "string"
            },
            "expected_naturalness_markers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "provocation",
            "expected_naturalness_markers"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "lines"
    ],
    "additionalProperties": false
  },
  "shadowingLineResponseSchema": {
